# ===== core n8n settings =====
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# ===== copied from your docker run =====
GENERIC_TIMEZONE=
TZ=
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true

# ===== extra: protect UI with basic auth =====
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=user
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_FORM_URL=link

# OPTIONAL: if you later want to drive OpenAI from env,
# you can wire your OpenAI credential to this:
OPENAI_API_KEY=

# Google OAuth (for all Google services)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
