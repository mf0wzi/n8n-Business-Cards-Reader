    {
      "parameters": {
        "jsCode": "// Get the raw output from the previous node (the output should be a string)\nlet extractedData = $input.first().json.output;  // Assuming the field is 'output' from ChatGPT Node\n\n// Parse the cleaned string into a proper JSON object\nlet parsedData;\ntry {\n  // First, clean the string by removing extra escaped newline characters and fixing other formatting issues\n  extractedData = extractedData.replace(/\\\\n/g, '');  // Remove all escaped newline characters (\\n)\n  extractedData = extractedData.replace(/\\\\\"/g, '\"');  // Fix any escaped quotes (\\\")\n\n  // Now parse it into a JSON object\n  parsedData = JSON.parse(extractedData);  // Convert the cleaned string into a JSON object\n} catch (e) {\n  // If parsing fails, log an error\n  throw new Error('Failed to parse JSON output from ChatGPT');\n}\n\n// Define the fields you want to check and provide default values if missing\nconst fields = [\n  \"name\", \"mobile\", \"second_mobile\", \"phone\", \"fax\", \"email\", \"address\", \"business_name\", \"title\", \"website\"\n];\n\n// Loop through each field and check if it's missing or undefined\nfields.forEach(field => {\n  // If the field is missing or undefined, assign a default value\n  if (!parsedData[field]) {\n    parsedData[field] = \"N/A\";  // You can customize this default message\n  }\n});\n\n// Return the cleaned and parsed result as an array of dictionaries (in n8n's format)\nreturn [\n  {\n    json: parsedData  // Return the parsed JSON as an output\n  }\n];\n"
      },
