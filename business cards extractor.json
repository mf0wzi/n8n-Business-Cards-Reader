    {
      "parameters": {
        "operation": "completion",
        "respondWith": "showText",
        "responseText": "=<style>\n  .n8n-success-wrapper {\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 16px;\n    background: radial-gradient(circle at top left, #fdfbff, #e5ecff);\n    font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  }\n\n  .n8n-success-card {\n    max-width: 420px;\n    width: 100%;\n    background: #ffffff;\n    border-radius: 16px;\n    border: 1px solid rgba(148, 163, 184, 0.4);\n    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.12);\n    padding: 24px 22px 26px;\n    text-align: center;\n    color: #0f172a;\n  }\n\n  .n8n-success-card h2 {\n    margin: 0 0 8px;\n    font-size: 1.4rem;\n    font-weight: 600;\n  }\n\n  .n8n-success-card p {\n    margin: 0 0 18px;\n    font-size: 0.95rem;\n    color: #4b5563;\n  }\n\n  .n8n-success-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    padding: 10px 18px;\n    border-radius: 999px;\n    text-decoration: none;\n    font-size: 0.9rem;\n    font-weight: 600;\n    background: linear-gradient(135deg, #6366f1, #8b5cf6);\n    color: #ffffff;\n    box-shadow: 0 10px 24px rgba(79, 70, 229, 0.45);\n    transition: transform 0.14s ease, box-shadow 0.14s ease, filter 0.14s ease;\n  }\n\n  .n8n-success-btn:hover {\n    transform: translateY(-1px);\n    box-shadow: 0 14px 32px rgba(79, 70, 229, 0.55);\n    filter: brightness(1.03);\n  }\n\n  .n8n-success-btn:active {\n    transform: translateY(0);\n    box-shadow: 0 8px 18px rgba(79, 70, 229, 0.35);\n  }\n</style>\n\n<div class=\"n8n-success-wrapper\">\n  <div class=\"n8n-success-card\">\n    <h2>\n      {{ $json.Status === 'success'\n        ? '✅ Business card saved successfully'\n        : '❌ Problem saving business card'\n      }}\n    </h2>\n\n    <p>\n      {{ $json.Status === 'success'\n        ? 'Your card has been stored in our system.'\n        : 'Something went wrong while processing your card. Please try again.'\n      }}\n    </p>\n\n    <p>\n      <a\n        class=\"n8n-success-btn\"\n        href=\"http://localhost:5678/form/a8d4f7c4-33c6-4a44-b5e3-d99e206952b2\"\n      >\n        Upload another card\n      </a>\n    </p>\n  </div>\n</div>"
      },
